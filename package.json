{
  "name": "pi-dc-distill",
  "version": "0.2.0",
  "description": "Deterministic local context compaction for Pi using bounded conversation excerpts and observations. No LLM calls.",
  "author": "Gary Blankenship",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "context-compaction",
    "context-management",
    "developer-tools",
    "ai-agents",
    "typescript",
    "bun",
    "local-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "lib/compaction-source.ts",
    "lib/local-compact.ts",
    "lib/sdk.ts",
    "lib/unicode.ts",
    "lib/sha256.ts",
    "lib/compiler/types.ts",
    "lib/compiler/normalizer.ts",
    "lib/compiler/tool-tracker.ts",
    "lib/compiler/budget-formatter.ts",
    "lib/compiler/helpers.ts",
    "lib/compiler/signal.ts",
    "lib/compiler/errors.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck",
    "distill:e2e": "bun test ./tests/e2e/lifecycle.e2e.ts ./tests/e2e/interception.e2e.ts",
    "distill:architecture": "bun scripts/check-architecture.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "fast-check": "4.10.2",
    "dependency-cruiser": "18.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.0",
  "homepage": "https://github.com/dotcommander/pi-dc-distill#readme",
  "bugs": {
    "url": "https://github.com/dotcommander/pi-dc-distill/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotcommander/pi-dc-distill.git"
  },
  "exports": {
    ".": "./index.ts"
  }
}
