{
  "name": "pi-dc-shrink",
  "version": "0.1.0",
  "description": "Deterministic provider-free context and tool-output compaction for Pi.",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "keywords": ["pi-package", "pi-extension"],
  "pi": { "extensions": ["./index.ts"] },
  "imports": {
    "#shrink-framework": "./lib/framework/index.ts",
    "#shrink-framework/*": "./lib/framework/*.ts"
  },
  "files": ["index.ts", "lib/**", "docs/**", "README.md", "CLAUDE.md", "LICENSE", "tsconfig.json", "!**/*.test.ts"],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.4.0",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3"
  }
}
