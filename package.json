{
  "name": "pi-dc-distill",
  "version": "0.1.6",
  "description": "Deterministic, local context compaction for the Pi coding agent. No LLM calls; includes tool-output previews and project-scoped recall.",
  "author": "Gary Blankenship",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi-coding-agent",
    "pi-package",
    "pi-extension",
    "context-compaction",
    "context-management",
    "developer-tools",
    "ai-agents",
    "typescript",
    "bun",
    "local-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "bin": {
    "dc-distill-session": "./bin/dc-distill-session.ts"
  },
  "files": [
    "index.ts",
    "bin/**",
    "lib/**",
    "docs/**",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "tsconfig.json",
    "!**/*.test.ts",
    "!**/.work/**",
    "!**/.*",
    "bun.lock",
    "tests/compare-session.ts",
    "tests/fixtures/**"
  ],
  "scripts": {
    "distill:session": "bun ./bin/dc-distill-session.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck",
    "distill:e2e": "bun test ./tests/e2e/lifecycle.e2e.ts ./tests/e2e/interception.e2e.ts ./tests/e2e/busy-compaction.e2e.ts",
    "distill:demo": "bun run tests/e2e/demo.ts",
    "distill:compare": "bun run tests/compare-session.ts",
    "distill:architecture": "bun scripts/check-architecture.ts",
    "distill:quality": "bun scripts/evaluate-selector.ts",
    "distill:performance": "bun scripts/benchmark-compiler.ts --checkpoint"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "fast-check": "4.10.2",
    "dependency-cruiser": "18.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.0",
  "homepage": "https://github.com/dotcommander/pi-dc-distill#readme",
  "bugs": {
    "url": "https://github.com/dotcommander/pi-dc-distill/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotcommander/pi-dc-distill.git"
  }
}
